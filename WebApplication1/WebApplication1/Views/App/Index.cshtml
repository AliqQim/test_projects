@if (ViewBag.IsAuthenticated)
{
    <img src="@ViewBag.PictureUrl" alt="Google Photo" style="border-radius:50%; width:48px; height:48px;" />
    <a href="/Account/Logout" style="margin-left:15px;">Logout</a>
}
else
{
    <a href="/Account/login-google" style="margin-left:15px;">Login</a>
}

<button id="ajaxButton">Get Message</button>
<div id="result" style="margin-top:10px; color:blue;"></div>

<script>
    document.getElementById('ajaxButton').addEventListener('click', function () {
        fetch('/weatherforecast')
            .then(response => response.text())
            .then(data => {
                document.getElementById('result').textContent = data;
            })
            .catch(error => {
                document.getElementById('result').textContent = 'Error: ' + error;
            });
    });
</script>


